# Copy to .env for `netlify dev`, or set these in Netlify > Site configuration > Environment variables.
# Every engine is optional. Engines without a key are shown as "unavailable" in the UI.
# With no keys at all, the app offers a clearly labelled demo report.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Reasoning effort for OpenAI reasoning models (none|low|medium|high). Leave empty to omit the parameter.
OPENAI_REASONING_EFFORT=low
# Set to true to let the OpenAI engine use the web_search tool (closer to ChatGPT with search, costs more).
OPENAI_WEB_SEARCH=false

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_API_URL=https://api.perplexity.ai/v1/sonar

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set to true to ground Gemini answers with Google Search (closer to the Gemini app; search queries are billed).
GEMINI_GROUNDING=false
# Thinking level for Gemini (low|medium|high; minimal on some models). Leave empty to omit the parameter.
GEMINI_THINKING_LEVEL=low

# Website audit: optional Google PageSpeed Insights key. Without it the GEO checks still run.
PAGESPEED_API_KEY=

# Guards
ENGINE_TIMEOUT_MS=20000
MAX_OUTPUT_TOKENS=900
RATE_LIMIT_REQUESTS=45
RATE_LIMIT_WINDOW_MS=900000
